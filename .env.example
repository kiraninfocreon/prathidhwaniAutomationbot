# Only low-level/infra settings live here. Everything else (API URL, admin
# numbers, message template, schedule, groups, branding) is configured from
# the web frontend once the app is running.

PORT=3000

# Where WhatsApp session credentials, config.json, and saved groups are
# stored. MUST point somewhere OUTSIDE the project folder (e.g. /opt/...)
# on real persistent disk (not /tmp or an ephemeral mount) — otherwise a
# redeploy that replaces the project directory (fresh git clone, re-uploaded
# zip, rm -rf + re-clone) silently wipes the linked WhatsApp session and every
# saved setting, forcing a fresh QR scan and re-configuration every time.
# If left blank, this defaults to a hidden folder in the running user's home
# directory — fine, but fragile if the process is ever started a different
# way (a different user, cron vs interactive shell, etc.), since that
# silently points at a different, empty folder and looks exactly like a
# logout even though nothing was actually deleted. Set this explicitly.
PERSIST_DIR=/opt/prathidhwani-bot-data

# WhatsApp connectivity runs on Baileys (talks WhatsApp's protocol directly),
# not a Chrome/Puppeteer browser — no CHROME_PATH or Chrome install needed.

# Optional: protect the whole frontend + API with a simple password.
# Leave blank to disable auth (fine for a private droplet behind a firewall).
DASHBOARD_PASSWORD=

# Session secret for the login cookie (only used if DASHBOARD_PASSWORD is set)
SESSION_SECRET=change-this-to-a-random-string
